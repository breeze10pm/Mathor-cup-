# Keep source files consistent across Windows and other platforms.
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.txt text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary documents, figures, and scientific data must not be normalized.
*.pdf binary
*.png binary
*.jpg binary
*.tif binary
*.gpkg binary
*.nc binary
